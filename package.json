{
  "name": "extra-terram",
  "version": "0.8.2",
  "private": true,
  "description": "Extra Terram: The Alien Race Tower Defense — Phase 1–3: vertical slice, four races, accounts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-content.mjs",
    "sim": "tsx scripts/sim-smoke.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "art": "python scripts/gen-background.py && python scripts/gen-icons.py && python scripts/cut-sheets.py && python scripts/sprites.py --fit && python scripts/gen-guides.py",
    "sprites": "python scripts/sprites.py",
    "cut-sheets": "python scripts/cut-sheets.py && python scripts/sprites.py --fit",
    "guides": "python scripts/gen-guides.py",
    "check-map": "python scripts/check-map.py",
    "cut-strip": "python scripts/cut-strip.py",
    "optimize-strips": "python scripts/optimize-strips.py",
    "art-drop": "python scripts/clean-stills.py && python scripts/sprites.py --refit && python scripts/optimize-strips.py && python scripts/sprites.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "pixi.js": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}

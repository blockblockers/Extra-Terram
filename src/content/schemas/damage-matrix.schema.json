{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://extraterram.app/schemas/damage-matrix.schema.json",
  "title": "Damage-type vs armour-type multipliers (one damage type and one armour per race)",
  "type": "object",
  "required": [
    "content_version",
    "multipliers"
  ],
  "additionalProperties": false,
  "properties": {
    "content_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "multipliers": {
      "type": "object",
      "required": [
        "thorn",
        "kinetic",
        "acid",
        "energy"
      ],
      "additionalProperties": false,
      "properties": {
        "thorn": {
          "$ref": "#/$defs/row"
        },
        "kinetic": {
          "$ref": "#/$defs/row"
        },
        "acid": {
          "$ref": "#/$defs/row"
        },
        "energy": {
          "$ref": "#/$defs/row"
        }
      }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": [
        "bark",
        "plated",
        "carapace",
        "shielded"
      ],
      "additionalProperties": false,
      "properties": {
        "bark": {
          "type": "number",
          "minimum": 0
        },
        "plated": {
          "type": "number",
          "minimum": 0
        },
        "carapace": {
          "type": "number",
          "minimum": 0
        },
        "shielded": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}

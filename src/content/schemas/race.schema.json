{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://extraterram.app/schemas/race.schema.json",
  "title": "Races content file",
  "type": "object",
  "required": ["content_version", "races"],
  "additionalProperties": false,
  "properties": {
    "content_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "races": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "damageTypes", "creepArmor", "palette"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "damageTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["kinetic", "energy", "bio"] }
          },
          "creepArmor": { "enum": ["organic", "plated", "shielded"] },
          "palette": {
            "type": "object",
            "required": ["primary", "secondary"],
            "additionalProperties": false,
            "properties": {
              "primary": { "$ref": "#/$defs/color" },
              "secondary": { "$ref": "#/$defs/color" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
  }
}

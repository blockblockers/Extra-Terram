{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://extraterram.app/schemas/wave.schema.json",
  "title": "Wave script content file",
  "type": "object",
  "required": [
    "id",
    "map",
    "startingResources",
    "lives",
    "firstBuildTicks",
    "buildTicks",
    "waveBonus",
    "waves",
    "content_version"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "map": {
      "type": "string",
      "description": "map id this script runs on"
    },
    "startingResources": {
      "type": "integer",
      "minimum": 0
    },
    "lives": {
      "type": "integer",
      "minimum": 1
    },
    "firstBuildTicks": {
      "type": "integer",
      "minimum": 0
    },
    "buildTicks": {
      "type": "integer",
      "minimum": 0
    },
    "waveBonus": {
      "type": "integer",
      "minimum": 0
    },
    "waves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "groups"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "groups": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "creep",
                "count",
                "intervalTicks",
                "delayTicks"
              ],
              "additionalProperties": false,
              "properties": {
                "creep": {
                  "type": "string"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                },
                "intervalTicks": {
                  "type": "integer",
                  "minimum": 1
                },
                "delayTicks": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "content_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "scaling": {
      "type": "object",
      "additionalProperties": false,
      "description": "Difficulty: level-wide multipliers plus a per-wave ramp; see WaveScaling in the engine",
      "properties": {
        "hpMult": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10
        },
        "speedMult": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 5
        },
        "countMult": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 5
        },
        "hpPerWave": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "speedPerWave": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rampWaves": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "hpMult and speedMult phase in over this many waves (0 = from wave 1); counts are never eased"
        }
      }
    },
    "endless": {
      "type": "object",
      "additionalProperties": false,
      "description": "growth past the script: 1 + max * x / (x + k)",
      "properties": {
        "hpMax": {
          "type": "number",
          "minimum": 0
        },
        "hpK": {
          "type": "number",
          "minimum": 0
        },
        "countMax": {
          "type": "number",
          "minimum": 0
        },
        "countK": {
          "type": "number",
          "minimum": 0
        },
        "speedMax": {
          "type": "number",
          "minimum": 0
        },
        "speedK": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "difficulty": {
      "type": "object",
      "additionalProperties": false,
      "description": "this level's Hard and Brutal steps, in level-factor units",
      "properties": {
        "hard": {
          "type": "number",
          "minimum": 0
        },
        "brutal": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
